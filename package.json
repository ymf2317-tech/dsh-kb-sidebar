{
  "name": "dsh-kb-sidebar",
  "version": "0.3.1",
  "description": "知识库速查面板：DSH 右侧边栏的「知识库」标签页（依赖上游插件 dsh-knowledge-base-local 提供同源 /kb-api）—— 混合检索、命中段落直接定位、文档目录跳转、集合与标签筛选、专注模式、断点续读，专为窄栏与触屏设计。",
  "author": "ymf2317-tech",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymf2317-tech/dsh-kb-sidebar.git"
  },
  "homepage": "https://github.com/ymf2317-tech/dsh-kb-sidebar#readme",
  "bugs": {
    "url": "https://github.com/ymf2317-tech/dsh-kb-sidebar/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "sidebar",
    "markdown"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "dsh-knowledge-base-local": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "dsh-knowledge-base-local": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "sideEffects": false,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "manifestVersion": 1
  }
}
